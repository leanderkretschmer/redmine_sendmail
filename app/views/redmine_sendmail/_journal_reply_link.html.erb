<%# "Reply" link under a comment that arrived by e-mail. All data the JS
     needs to pre-fill the notes form (recipients, subject, quote source)
     travels in data attributes; the click handler lives in redmine_sendmail.js. %>
<div class="redmine-sendmail-reply"
     data-sendmail-reply
     data-journal-id="<%= journal.id %>"
     data-journal-indice="<%= journal.indice %>"
     data-reply-origin="<%= origin %>"
     data-reply-subject="<%= h(subject) %>"
     data-reply-contacts="<%= h(recipients[:contacts].to_json) %>"
     data-reply-adhoc="<%= h(recipients[:adhoc].to_json) %>">
  <a href="#" class="redmine-sendmail-reply-link icon icon-email"
     title="<%= l(:label_sendmail_reply_origin_email) %>"><%= sprite_icon('email', l(:label_sendmail_reply)) %></a>
</div>
